ignore:
  - images
  - ignored
  - .github
  - .gitignore
  - .claude
  - .luacheckrc
  - .luarc.json
  - .styluaignore
  - stylua.toml
  - scripts
  - Makefile
  - README.md
  - CURSEFORGE.md
  - CLAUDE.md
  - CONTRIBUTING.md
  - types.lua
